{
	"name": "atollic",
	"version": "0.1.0",
	"description": "Island architecture for WinterCG-compatible runtimes. Bring-your-own server (Elysia, Hono, …) and UI framework, powered by Vite.",
	"keywords": [
		"wintercg",
		"islands",
		"island-architecture",
		"vite",
		"ssr",
		"hydration",
		"elysia",
		"hono"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/awilderink/atollic.git"
	},
	"bugs": {
		"url": "https://github.com/awilderink/atollic/issues"
	},
	"homepage": "https://github.com/awilderink/atollic#readme",
	"type": "module",
	"scripts": {
		"dev:elysia": "cd examples/elysia && bunx --bun vite",
		"dev:hono": "cd examples/hono && bunx --bun vite",
		"build": "vite build && tsc",
		"build:examples": "cd examples/elysia && bunx --bun vite build && cd ../hono && bunx --bun vite build",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit && tsc --noEmit --project examples/elysia/tsconfig.json && tsc --noEmit --project examples/hono/tsconfig.json",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"test:unit": "bun test src/",
		"test:e2e": "playwright test",
		"test:e2e:elysia": "playwright test --project=elysia",
		"test:e2e:hono": "playwright test --project=hono",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./adapter": {
			"types": "./dist/adapter.d.ts",
			"import": "./dist/adapter.js"
		},
		"./head": {
			"types": "./dist/head.d.ts",
			"import": "./dist/head.js"
		},
		"./solid": {
			"types": "./dist/adapters/solid.d.ts",
			"import": "./dist/adapters/solid.js"
		},
		"./react": {
			"types": "./dist/adapters/react.d.ts",
			"import": "./dist/adapters/react.js"
		},
		"./elysia": {
			"types": "./dist/servers/elysia.d.ts",
			"import": "./dist/servers/elysia.js"
		},
		"./hono": {
			"types": "./dist/servers/hono.d.ts",
			"import": "./dist/servers/hono.js"
		},
		"./jsx-runtime": {
			"types": "./dist/html/jsx-runtime.d.ts",
			"import": "./dist/html/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/html/jsx-dev-runtime.d.ts",
			"import": "./dist/html/jsx-dev-runtime.js"
		},
		"./html": {
			"types": "./dist/html/index.d.ts",
			"import": "./dist/html/index.js"
		}
	},
	"files": [
		"dist/*.js",
		"dist/*.d.ts",
		"dist/adapters/*.js",
		"dist/adapters/*.d.ts",
		"dist/servers/*.js",
		"dist/servers/*.d.ts",
		"dist/html/*.js",
		"dist/html/*.d.ts"
	],
	"dependencies": {
		"idiomorph": "^0.7.4"
	},
	"peerDependencies": {
		"@vitejs/plugin-react": "^6.0.1",
		"elysia": "^1.4.27",
		"hono": "^4.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"solid-js": "^1.9.11",
		"vite": "^8.0.0",
		"vite-plugin-solid": "^2.11.11"
	},
	"peerDependenciesMeta": {
		"@vitejs/plugin-react": {
			"optional": true
		},
		"elysia": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		},
		"vite-plugin-solid": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.27.10",
		"@playwright/test": "^1.49.0",
		"@types/node": "^25.5.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.0.1",
		"bun-types": "^1.3.11",
		"elysia": "^1.4.28",
		"hono": "^4.12.9",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"solid-js": "^1.9.11",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vite-plugin-solid": "^2.11.11"
	}
}
